@page
@model EmpleadaHogar.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-brand">
            <div class="auth-brand-mark">H</div>
            <div class="auth-brand-name">
                Empleada<span>Hogar</span>
            </div>
        </div>

        <div class="auth-decoration"></div>

        <div class="auth-heading">
            <span class="auth-eyebrow">GESTIÓN DEL HOGAR</span>
            <h1>Bienvenido de nuevo</h1>
            <p>Accede a tu espacio de gestión y consulta toda la información de tu hogar.</p>
        </div>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="auth-validation"></div>
            }

            <div class="auth-field">
                <label asp-for="Input.Email">Correo electrónico</label>
                <input asp-for="Input.Email"
                       class="auth-input"
                       placeholder="Tu correo electrónico"
                       autocomplete="username"
                       autofocus />
                <span asp-validation-for="Input.Email" class="auth-field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Input.Password">Contraseña</label>
                <input asp-for="Input.Password"
                       class="auth-input"
                       placeholder="Tu contraseña"
                       autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="auth-field-error"></span>
            </div>

            <div class="auth-options">
                <label class="auth-remember">
                    <input asp-for="Input.RememberMe" type="checkbox" class="auth-checkbox" />
                    <span>Mantener la sesión iniciada</span>
                </label>

                <a asp-page="./ForgotPassword" class="auth-forgot">
                    ¿Has olvidado tu contraseña?
                </a>
            </div>

            <button type="submit" class="auth-submit">
                Iniciar sesión <span>→</span>
            </button>
        </form>

        <div class="auth-footer">
            <span></span>
            EmpleadaHogar
            <span></span>
        </div>

        <p class="auth-privacy">Acceso privado · Información protegida</p>
        <div class="auth-register">
            <span class="auth-register-caption">¿Es tu primera vez?</span>
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="auth-register-link">
                <span class="auth-register-icon" aria-hidden="true">＋</span>
                <span class="auth-register-text">
                    <strong>Crear una cuenta</strong>
                    <small>Registrar un nuevo usuario</small>
                </span>
                <span class="auth-register-arrow" aria-hidden="true">→</span>
            </a>
        </div>
    </div>

    <div class="auth-copyright">
        © @DateTime.Now.Year EmpleadaHogar
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}