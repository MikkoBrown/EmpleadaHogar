@page
@model EmpleadaHogar.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Nueva contraseña";
}
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-brand"><div class="auth-brand-mark">H</div><div class="auth-brand-name">Empleada<span>Hogar</span></div></div>
        <div class="auth-heading">
            <span class="auth-eyebrow">RECUPERAR ACCESO</span>
            <h1>Establecer contraseña nueva</h1>
            <p>Introduce tu correo y la nueva contraseña para tu cuenta.</p>
        </div>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="auth-validation" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />
            <div class="auth-field">
                <label asp-for="Input.Email">Correo electrónico</label>
                <input asp-for="Input.Email" class="auth-input" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="auth-field-error"></span>
            </div>
            <div class="auth-field">
                <label asp-for="Input.Password">Nueva contraseña</label>
                <input asp-for="Input.Password" class="auth-input" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="auth-field-error"></span>
            </div>
            <div class="auth-field">
                <label asp-for="Input.ConfirmPassword">Confirmar contraseña</label>
                <input asp-for="Input.ConfirmPassword" class="auth-input" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="auth-field-error"></span>
            </div>
            <button type="submit" class="auth-submit">Guardar contraseña <span>→</span></button>
        </form>
        <div class="auth-footer"><a asp-page="./Login">Volver al inicio de sesión</a></div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
