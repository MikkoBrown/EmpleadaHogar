@page
@model EmpleadaHogar.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">
            <div class="auth-brand-mark">H</div>
            <div class="auth-brand-name">Empleada<span>Hogar</span></div>
        </div>
        <div class="auth-heading">
            <span class="auth-eyebrow">RECUPERAR ACCESO</span>
            <h1>¿Has olvidado tu contraseña?</h1>
            <p>Introduce tu correo electrónico y te enviaremos un enlace para crear una contraseña nueva.</p>
        </div>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="auth-validation" role="alert"></div>
            <div class="auth-field">
                <label asp-for="Input.Email">Correo electrónico</label>
                <input asp-for="Input.Email" class="auth-input" autocomplete="email" placeholder="Tu correo electrónico" />
                <span asp-validation-for="Input.Email" class="auth-field-error"></span>
            </div>
            <button type="submit" class="auth-submit">Enviar enlace <span>→</span></button>
        </form>
        <div class="auth-footer"><a asp-page="./Login">Volver al inicio de sesión</a></div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
