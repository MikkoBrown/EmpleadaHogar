@model EmpleadaHogar.ViewModels.PagedResult<EmpleadaHogar.Models.EmployeeProfile>
@{ ViewData["Title"] = "Trabajadoras"; }
<div class="section-page">
        <div class="welcome-row"><div><div class="eyebrow">TU ESPACIO PRIVADO</div><h1>Trabajadoras</h1><p class="subhead">Contratos y datos laborales de las personas empleadas.</p></div><a class="primary-button" asp-action="Create">＋ Añadir trabajadora</a></div>
        @if (TempData["Success"] is string success) { <div class="form-success">@success</div> }
        @if (Model.TotalCount == 0)
        {
            <section class="panel empty-list"><div class="empty-icon">♙</div><h2>Aún no has añadido trabajadoras</h2><p>Necesitas registrar un empleador/a antes de añadir una trabajadora.</p><a class="primary-button" asp-controller="Employers" asp-action="Index">Gestionar empleadores</a></section>
        }
        else
        {
            <section class="panel"><div class="table-responsive"><table class="data-table"><thead><tr><th>Trabajadora</th><th>Empleador/a</th><th>Jornada</th><th>Bruto mensual</th><th>Contrato</th><th></th></tr></thead><tbody>
            @foreach (var employee in Model.Items) { <tr><td><strong>@employee.FirstName @employee.LastName</strong></td><td>@employee.Employer.FirstName @employee.Employer.LastName</td><td>@employee.WeeklyHours.ToString("0.##") h/semana</td><td>@((employee.MonthlyBaseSalary + employee.ExtraPaymentsMonthly).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-ES")))</td><td>@employee.ContractType</td><td><a class="text-link" asp-action="Edit" asp-route-id="@employee.Id">Editar</a></td></tr> }
            </tbody></table></div></section>
        }
        <form method="get" class="pagination-toolbar">
            <input type="search" name="search" value="@Model.Search" placeholder="Buscar..." class="form-control" />
            <select name="pageSize" class="form-select" onchange="this.form.submit()">
                <option value="10" selected="@(Model.PageSize == 10)">10</option><option value="20" selected="@(Model.PageSize == 20)">20</option><option value="50" selected="@(Model.PageSize == 50)">50</option>
            </select><button class="small-action" type="submit">Buscar</button>
        </form>
        <div class="pagination-summary">Mostrando @Model.FirstItem–@Model.LastItem de @Model.TotalCount</div>
        <nav class="pager" aria-label="Paginación">
            @if (Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search">← Anterior</a> }
            <span>Página @Model.Page de @Model.TotalPages</span>
            @if (Model.Page < Model.TotalPages) { <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search">Siguiente →</a> }
        </nav>
        <a class="back-link" asp-controller="Home" asp-action="Index">← Volver al resumen</a>
    </div>
