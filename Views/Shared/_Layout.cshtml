@using EmpleadaHogar.Models
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var activeHome = controller == "Home" ? "active" : "";
    var activeEmployers = controller == "Employers" ? "active" : "";
    var activeEmployees = controller == "Employees" ? "active" : "";
    var activePayrolls = controller == "Payrolls" ? "active" : "";
    var activeContributions = controller == "Concepts" && action == "Contributions" ? "active" : "";
    var activeDeductions = controller == "Concepts" && action == "Deductions" ? "active" : "";
    var breadcrumbTitle = controller switch { "Home" => "Resumen", "Employers" => "Empleadores", "Employees" => "Trabajadoras", "Payrolls" => "Nóminas", "Concepts" when action == "Contributions" => "Cotizaciones", "Concepts" when action == "Deductions" => "Deducciones", _ => ViewData["Title"]?.ToString() ?? "Gestión" };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · EmpleadosHogar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/identity.css" asp-append-version="true" />
</head>
<body>
<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">e</span><span>empleados<span class="brand-light">hogar</span></span></a>
        <div class="side-label">GESTIÓN</div>
        <a class="side-link @activeHome" asp-controller="Home" asp-action="Index"><span>◫</span> Resumen</a>
        <a class="side-link @activeEmployers" asp-controller="Employers" asp-action="Index"><span>⌂</span> Empleadores</a>
        <a class="side-link @activeEmployees" asp-controller="Employees" asp-action="Index"><span>♙</span> Trabajadoras</a>
        <a class="side-link @activePayrolls" asp-controller="Payrolls" asp-action="Index"><span>▤</span> Nóminas</a>
        <a class="side-link @activeContributions" asp-controller="Concepts" asp-action="Contributions"><span>◉</span> Cotizaciones</a>
        <a class="side-link @activeDeductions" asp-controller="Concepts" asp-action="Deductions"><span>−</span> Deducciones</a>
        <div class="side-bottom"><div class="profile-chip">@((User.Identity?.Name ?? "U").Substring(0, 1).ToUpperInvariant())</div><div><strong>Mi cuenta</strong><small>@User.Identity?.Name</small></div></div>
    </aside>
    <div class="main-area">
        <header class="topbar"><div class="breadcrumbs">Gestión del hogar <span>/</span> <b>@breadcrumbTitle</b></div><div class="top-actions"><partial name="_LoginPartial" /></div></header>
        <main class="content">@RenderBody()</main>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
